{
  "name": "opencode-tokenwise",
  "version": "1.0.0",
  "description": "Token analytics plugin for OpenCode",
  "main": "dist/plugin.js",
  "bin": {
    "opencode-analytics": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "bun build src/plugin.ts --outdir dist --target bun",
    "build:cli": "bun build src/cli/index.ts --outfile dist/cli/index.js --target bun --compile",
    "dev": "bun --watch src/plugin.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun run build:cli"
  },
  "keywords": [
    "opencode",
    "plugin",
    "analytics",
    "tokens",
    "usage"
  ],
  "author": "ens-Emilio",
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "latest",
    "commander": "^12.0.0",
    "hono": "^4.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "files": [
    "dist"
  ]
}